varnishtest "The cloudauth Azure provider fetches the tokens of the applications with their client secret"

feature cmd "$HAPROXY_PROGRAM -cc 'feature(CLOUDAUTH_AZURE)'"
feature ignore_unknown_macro

setenv CLOUDAUTH_AZ_CLIENT_SECRET "s3cr+t=&~x"

shell {
    printf 'file-secret\n' > "${tmpdir}/client-secret"
    chmod 600 "${tmpdir}/client-secret"
}

# Microsoft Entra ID, behind the TLS frontend of h1
server s1 -repeat 5 {
    rxreq
    expect req.method == "POST"
    expect req.url == "/contoso.onmicrosoft.com/oauth2/v2.0/token"
    expect req.http.content-type == "application/x-www-form-urlencoded"
    expect req.bodylen == 156
    expect req.body == "grant_type=client_credentials&client_id=11111111-2222-3333-4444-555555555555&client_secret=s3cr%2Bt%3D%26~x&scope=https%3A%2F%2Fstorage.azure.com%2F.default"
    txresp -hdr "Content-Type: application/json" \
        -body {{"token_type":"Bearer","expires_in":3599,"ext_expires_in":3599,"access_token":"entra-token"}}
} -start

# the secret is read from a file, and rejected
server s2 -repeat 5 {
    rxreq
    expect req.url == "/00000000-0000-0000-0000-000000000000/oauth2/v2.0/token"
    expect req.body ~ "&client_secret=file-secret&"
    txresp -status 401 -hdr "Content-Type: application/json" \
        -body {{"error":"invalid_client","error_description":"AADSTS7000215: do not report this"}}
} -start

# the storage
server s3 {
    rxreq
    expect req.http.authorization == "Bearer entra-token"
    expect req.http.x-ms-version == "2026-04-06"
    txresp -body "entra"
} -start

haproxy h1 -conf {
    global
        nbthread 1
        expose-experimental-directives
        # the test certificate is self-signed
        httpclient.ssl.verify none
    traces
        trace cloudauth sink buf0 level developer start now
    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server "${HAPROXY_TEST_TIMEOUT-5s}"
    cloudauth app
        provider azure
        signer bearer
        token client-secret
        azure-tenant-id contoso.onmicrosoft.com
        azure-client-id 11111111-2222-3333-4444-555555555555
        azure-client-secret env:CLOUDAUTH_AZ_CLIENT_SECRET
        azure-authority-host "https://${h1_entra_addr}:${h1_entra_port}/"
    cloudauth rejected
        provider azure
        signer bearer
        token client-secret
        azure-tenant-id 00000000-0000-0000-0000-000000000000
        azure-client-id 11111111-2222-3333-4444-555555555555
        azure-client-secret "file:${tmpdir}/client-secret"
        azure-authority-host "https://${h1_rejected_addr}:${h1_rejected_port}"
    frontend entra
        bind "fd@${entra}" ssl crt ${testdir}/../ssl/certs/common.pem
        default_backend be_entra
    frontend rejected
        bind "fd@${rejected}" ssl crt ${testdir}/../ssl/certs/common.pem
        default_backend be_rejected
    backend be_entra
        server s1 ${s1_addr}:${s1_port}
    backend be_rejected
        server s2 ${s2_addr}:${s2_port}
    frontend fe
        bind "fd@${fe}"
        # the client secret was removed from the environment
        http-request return status 200 content-type text/plain lf-string "env=%[env(CLOUDAUTH_AZ_CLIENT_SECRET)]" if { path /env }
        default_backend be_storage
    backend be_storage
        filter-config cloudauth enabled
        server srv ipv4@localhost:${s3_port} cloudauth app
} -start

# let the tokens be fetched
delay 1

client c1 -connect ${h1_fe_sock} {
    txreq -url "/blob"
    rxresp
    expect resp.status == 200
    expect resp.body == "entra"

    txreq -url "/env"
    rxresp
    expect resp.status == 200
    expect resp.body == "env="
} -run

haproxy h1 -cli {
    send "show cloudauth app"
    expect ~ "app\tazure\tbearer\tfetch:client-secret\tvalid\t"

    send "show cloudauth rejected"
    expect ~ "rejected\tazure\tbearer\tfetch:client-secret\tmissing\t.*\tthe token endpoint answered with status 401 \\(invalid_client\\)\t-\n"
}

# the fetching is traced, without the client secret, the token, nor the
# description of the error
haproxy h1 -cli {
    send "show events buf0"
    expect ~ "Microsoft Entra ID authority host : profile=app \\(https://${h1_entra_addr}:${h1_entra_port}\\)"
}

haproxy h1 -cli {
    send "show events buf0"
    expect ~ "credential requested from the token source : profile=app \\(client-secret\\)"
}

haproxy h1 -cli {
    send "show events buf0"
    expect ~ "response of the token endpoint : profile=app status=200"
}

haproxy h1 -cli {
    send "show events buf0"
    expect ~ "cannot fetch the credential : profile=rejected \\(the token endpoint answered with status 401 \\(invalid_client\\)\\)"
}

haproxy h1 -cli {
    send "show events buf0"
    expect !~ "s3cr|file-secret|entra-token|AADSTS"
}

# a valid token is fetched again on demand
haproxy h1 -cli {
    send "update cloudauth credential app"
    expect ~ "Fetch requested, see \"show cloudauth\" for its result."
}

delay 0.5

haproxy h1 -cli {
    send "show events buf0"
    expect ~ "(?s)credential requested from the token source : profile=app \\(client-secret\\).*fetch requested from the CLI : profile=app.*credential requested from the token source : profile=app \\(client-secret\\).*response of the token endpoint : profile=app status=200"
}

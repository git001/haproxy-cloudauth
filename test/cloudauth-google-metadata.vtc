varnishtest "The cloudauth Google provider fetches the tokens from the metadata server"

feature cmd "$HAPROXY_PROGRAM -cc 'feature(CLOUDAUTH_GOOGLE)'"
feature ignore_unknown_macro

# metadata server, the token expires quickly so that it must be refreshed
server s1 -repeat 10 {
    rxreq
    expect req.method == "GET"
    expect req.url == "/computeMetadata/v1/instance/service-accounts/default/token"
    expect req.http.metadata-flavor == "Google"
    txresp -hdr "Content-Type: application/json" \
        -body {{"access_token":"metadata-token","expires_in":2,"token_type":"Bearer"}}
} -start

# metadata server receiving the requested scopes
server s2 -repeat 5 {
    rxreq
    expect req.url == "/token?scopes=https%3A%2F%2Fwww.googleapis.com%2Fauth%2Fdevstorage.read_only%2Chttps%3A%2F%2Fwww.googleapis.com%2Fauth%2Fcloud-platform"
    expect req.http.metadata-flavor == "Google"
    txresp -hdr "Content-Type: application/json" \
        -body {{"access_token":"scoped-token","expires_in":3599,"token_type":"Bearer"}}
} -start

# metadata server in maintenance
server s3 -repeat 10 {
    rxreq
    txresp -status 503 -hdr "Content-Type: text/plain" -body "do not report this"
} -start

# the storage, the client credentials must be replaced
server s4 -repeat 2 {
    rxreq
    expect req.http.authorization == "Bearer metadata-token"
    expect req.http.x-goog-user-project == <undef>
    expect req.http.x-ms-version == <undef>
    txresp -body "metadata"
} -start

server s5 {
    rxreq
    expect req.http.authorization == "Bearer scoped-token"
    txresp -body "scoped"
} -start

haproxy h1 -conf {
    global
        nbthread 1
        expose-experimental-directives
    traces
        trace cloudauth sink buf0 level developer start now
    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server "${HAPROXY_TEST_TIMEOUT-5s}"
    cloudauth metadata
        provider google
        signer bearer
        token metadata-server
        token-endpoint "http://${s1_addr}:${s1_port}/computeMetadata/v1/instance/service-accounts/default/token"
    cloudauth scoped
        provider google
        signer bearer
        token metadata-server
        token-endpoint "http://${s2_addr}:${s2_port}/token"
        token-scopes https://www.googleapis.com/auth/devstorage.read_only https://www.googleapis.com/auth/cloud-platform
    cloudauth failing
        provider google
        signer bearer
        token metadata-server
        token-endpoint "http://${s3_addr}:${s3_port}/token"
        fetch-max-backoff 10s
    frontend fe
        bind "fd@${fe}"
        use_backend be_scoped if { path_beg /scoped/ }
        default_backend be_metadata
    backend be_metadata
        filter-config cloudauth enabled
        server srv ipv4@localhost:${s4_port} cloudauth metadata
    backend be_scoped
        filter-config cloudauth enabled
        server srv ipv4@localhost:${s5_port} cloudauth scoped
} -start

# let the tokens be fetched
delay 1

client c1 -connect ${h1_fe_sock} {
    txreq -url "/bucket/object" -hdr "Authorization: Bearer client-token" -hdr "X-Goog-User-Project: other"
    rxresp
    expect resp.status == 200
    expect resp.body == "metadata"

    txreq -url "/scoped/object"
    rxresp
    expect resp.status == 200
    expect resp.body == "scoped"
} -run

haproxy h1 -cli {
    send "show cloudauth failing"
    expect ~ "failing\tgoogle\tbearer\tfetch:metadata-server\tmissing\t.*\tthe token endpoint answered with status 503\t-\n"

    send "show cloudauth scoped"
    expect ~ "scoped\tgoogle\tbearer\tfetch:metadata-server\tvalid\t"

    send "set cloudauth credential metadata <<\nnew-token\n"
    expect ~ "The credential of this profile is fetched by HAProxy."
}

# the token expires after 2 seconds, it must have been refreshed
delay 2.5

client c2 -connect ${h1_fe_sock} {
    txreq -url "/bucket/object"
    rxresp
    expect resp.status == 200
    expect resp.body == "metadata"
} -run

# the endpoints are traced, without the tokens nor the error payload
haproxy h1 -cli {
    send "show events buf0"
    expect ~ "metadata server endpoint : profile=metadata \\(http://${s1_addr}:${s1_port}/computeMetadata/v1/instance/service-accounts/default/token\\)"
}

haproxy h1 -cli {
    send "show events buf0"
    expect !~ "metadata-token|scoped-token|client-token|do not report"
}

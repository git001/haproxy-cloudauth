varnishtest "The cloudauth Google provider signs the requests with the HMAC keys"

feature cmd "$HAPROXY_PROGRAM -vv | grep -qF 'Built with the cloudauth provider: google '"
feature ignore_unknown_macro

# the HMAC keys, as "<access-key-id>:<secret>"
shell {
    printf '%s\n' "GOOGTS7C7FUP3AIRVJTE2BCDKINBTES3HC2GY5CBFJDCQ2SYHV6A6XXVTJFSA:bGoa+V7g/yqDXvKRqq+JTFn4uQZbPiQJo4pf9RzJ" > "${tmpdir}/hmac-key"
    chmod 600 "${tmpdir}/hmac-key"
}

# Cloud Storage is played by h2, which computes the signature again with its
# own converters from the expected canonical URI, canonical query string and
# region given by the client, and from the signing key of the access key
# identifier, derived from the secret prefixed by "GOOG4" (in base64 below).
haproxy h2 -conf {
    global
        nbthread 1
    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server "${HAPROXY_TEST_TIMEOUT-5s}"
    frontend gcs
        bind "fd@${gcs}"
        http-request set-var(txn.date) req.hdr(x-goog-date)
        http-request set-var(txn.day) var(txn.date),bytes(0,8)
        http-request set-var(txn.region) req.hdr(x-test-region)
        http-request set-var(txn.id) req.fhdr(authorization),word(2,' '),field(1,/),bytes(11)
        http-request set-var(txn.k0) str(R09PRzRiR29hK1Y3Zy95cURYdktScXErSlRGbjR1UVpiUGlRSm80cGY5UnpK) if { var(txn.id) -m str GOOGTS7C7FUP3AIRVJTE2BCDKINBTES3HC2GY5CBFJDCQ2SYHV6A6XXVTJFSA }
        http-request set-var(txn.k0) str(R09PRzRjMlZqYjI1a0xYTmxZM0psZEMxclpYa3RabTl5TFhSb1pTMTBaWE4wY3c=) if { var(txn.id) -m str GOOGROTATED }
        http-request set-var(txn.k1) var(txn.day),hmac(sha256,txn.k0),base64
        http-request set-var(txn.k2) var(txn.region),hmac(sha256,txn.k1),base64
        http-request set-var(txn.k3) str(storage),hmac(sha256,txn.k2),base64
        http-request set-var(txn.k4) str(goog4_request),hmac(sha256,txn.k3),base64
        http-request set-var(txn.signed) str(host;x-goog-content-sha256;x-goog-date)
        http-request set-var-fmt(txn.creq) "%[method]\n%[req.hdr(x-test-uri)]\n%[req.hdr(x-test-query)]\nhost:%[req.hdr(host)]\nx-goog-content-sha256:UNSIGNED-PAYLOAD\nx-goog-date:%[var(txn.date)]\n\nhost;x-goog-content-sha256;x-goog-date\nUNSIGNED-PAYLOAD"
        http-request set-var-fmt(txn.creq) "%[method]\n%[req.hdr(x-test-uri)]\n%[req.hdr(x-test-query)]\nhost:%[req.hdr(host)]\nx-goog-content-sha256:UNSIGNED-PAYLOAD\nx-goog-date:%[var(txn.date)]\nx-goog-meta-color:blue green\n\nhost;x-goog-content-sha256;x-goog-date;x-goog-meta-color\nUNSIGNED-PAYLOAD" if { req.hdr(x-goog-meta-color) -m found }
        http-request set-var(txn.signed) str(host;x-goog-content-sha256;x-goog-date;x-goog-meta-color) if { req.hdr(x-goog-meta-color) -m found }
        http-request set-var-fmt(txn.sts) "GOOG4-HMAC-SHA256\n%[var(txn.date)]\n%[var(txn.day)]/%[var(txn.region)]/storage/goog4_request\n%[var(txn.creq),sha2(256),hex,lower]"
        http-request set-var(txn.sig) var(txn.sts),hmac(sha256,txn.k4),hex,lower
        http-request set-var-fmt(txn.auth) "GOOG4-HMAC-SHA256 Credential=%[var(txn.id)]/%[var(txn.day)]/%[var(txn.region)]/storage/goog4_request, SignedHeaders=%[var(txn.signed)], Signature=%[var(txn.sig)]"
        http-request return status 400 content-type text/plain string "bad headers" unless { req.hdr(x-goog-date) -m reg ^[0-9]{8}T[0-9]{6}Z$ } { req.hdr(x-goog-content-sha256) -m str UNSIGNED-PAYLOAD } { req.hdr_cnt(x-goog-date) -m int 1 } { req.fhdr_cnt(authorization) -m int 1 } !{ req.hdr(x-goog-user-project) -m found }
        http-request return status 200 content-type text/plain lf-string "%[var(txn.id)]" if { req.fhdr(authorization),strcmp(txn.auth) eq 0 }
        http-request return status 403 content-type text/plain lf-string "%[var(txn.creq)]"
} -start

haproxy h1 -conf {
    global
        nbthread 1
        expose-experimental-directives
    defaults
        mode http
        timeout connect "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout client "${HAPROXY_TEST_TIMEOUT-5s}"
        timeout server "${HAPROXY_TEST_TIMEOUT-5s}"
    # the default region
    cloudauth hmac
        provider google
        signer sigv4
        token "file:${tmpdir}/hmac-key"
    # another region
    cloudauth regional
        provider google
        signer sigv4
        region us-central1
        token "file:${tmpdir}/hmac-key"
    frontend fe
        bind "fd@${fe}"
        # the headers of the storage which the clients must not use are
        # removed by the HTTP rules
        http-request del-header x-goog-user-project
        use_backend be_regional if { path_beg /regional/ }
        default_backend be_hmac
    backend be_hmac
        filter-config cloudauth enabled profile hmac host localhost
        server srv ipv4@localhost:${h2_gcs_port}
    backend be_regional
        filter-config cloudauth enabled profile regional host localhost
        server srv ipv4@localhost:${h2_gcs_port}
} -start

client c1 -connect ${h1_fe_sock} {
    # the signature headers of the client are replaced
    txreq -url "/bucket/object" -hdr "x-test-uri: /bucket/object" -hdr "x-test-query: " \
        -hdr "x-test-region: auto" -hdr "Authorization: AWS4-HMAC-SHA256 Credential=client" \
        -hdr "x-goog-date: 20000101T000000Z" -hdr "x-goog-user-project: other"
    rxresp
    expect resp.status == 200
    expect resp.body == "GOOGTS7C7FUP3AIRVJTE2BCDKINBTES3HC2GY5CBFJDCQ2SYHV6A6XXVTJFSA"

    # the path and the query string are decoded, then encoded again with only
    # the unreserved characters, the parameters being sorted
    txreq -url "/bucket/dir/a%20b+c~d%2a.txt?z=1&list-type=2&prefix=dir%2F&a=b+c&empty&a=a" \
        -hdr "x-test-uri: /bucket/dir/a%20b%2Bc~d%2A.txt" \
        -hdr "x-test-query: a=a&a=b%20c&empty=&list-type=2&prefix=dir%2F&z=1" \
        -hdr "x-test-region: auto"
    rxresp
    expect resp.status == 200

    txreq -url "/regional/" -hdr "x-test-uri: /regional/" -hdr "x-test-query: " \
        -hdr "x-test-region: us-central1"
    rxresp
    expect resp.status == 200

    # a write: the headers of the client are signed
    txreq -req PUT -url "/bucket/object" -hdr "x-test-uri: /bucket/object" -hdr "x-test-query: " \
        -hdr "x-test-region: auto" -hdr "x-goog-meta-color: blue  green" -body "hello"
    rxresp
    expect resp.status == 200
} -run

# the key is rotated from the CLI, the token being checked first
haproxy h1 -cli {
    send "set cloudauth credential hmac <<\nno-secret\n"
    expect ~ "the token of the 'sigv4' signer must be '<access-key-id>:<secret>'"

    send "set cloudauth credential hmac <<\nGOOGROTATED:c2Vjb25kLXNlY3JldC1rZXktZm9yLXRoZS10ZXN0cw\n"
    expect ~ "Credential updated."
}

client c2 -connect ${h1_fe_sock} {
    txreq -url "/bucket/object" -hdr "x-test-uri: /bucket/object" -hdr "x-test-query: " \
        -hdr "x-test-region: auto"
    rxresp
    expect resp.status == 200
    expect resp.body == "GOOGROTATED"
} -run
